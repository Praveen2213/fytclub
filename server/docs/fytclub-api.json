        {
          "name": "http://localhost:3000/api/battles/6/decline",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Parse HTML response to extract posts",
                  "const responseText = pm.response.text();",
                  "",
                  "// Extract posts using regex",
                  "const postRegex = /<div class=\"post\">\\s*<h3 class=\"user\">([^<]+)<\\/h3>\\s*<h4 class=\"content\">([^<]+)<\\/h4>\\s*<\\/div>/g;",
                  "const posts = [];",
                  "let match;",
                  "",
                  "while ((match = postRegex.exec(responseText)) !== null) {",
                  "    posts.push({",
                  "        user: match[1].trim(),",
                  "        content: match[2].trim()",
                  "    });",
                  "}",
                  "",
                  "// Create visualization template with Chart.js",
                  "var template = `",
                  "<div style=\"padding: 20px; font-family: Arial, sans-serif;\">",
                  "    <h2 style=\"text-align: center; color: #333;\">Quora Posts Visualization</h2>",
                  "    <canvas id=\"postsChart\" height=\"100\"></canvas>",
                  "    <div style=\"margin-top: 30px;\">",
                  "        <h3>Posts Details:</h3>",
                  "        <table style=\"width: 100%; border-collapse: collapse;\">",
                  "            <tr style=\"background-color: #f2f2f2;\">",
                  "                <th style=\"padding: 10px; border: 1px solid #ddd; text-align: left;\">User</th>",
                  "                <th style=\"padding: 10px; border: 1px solid #ddd; text-align: left;\">Content</th>",
                  "            </tr>",
                  "            {{#each posts}}",
                  "            <tr>",
                  "                <td style=\"padding: 10px; border: 1px solid #ddd;\">{{user}}</td>",
                  "                <td style=\"padding: 10px; border: 1px solid #ddd;\">{{content}}</td>",
                  "            </tr>",
                  "            {{/each}}",
                  "        </table>",
                  "    </div>",
                  "</div>",
                  "<script src=\"https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js\"></script>",
                  "<script>",
                  "    var ctx = document.getElementById(\"postsChart\");",
                  "    var postsChart = new Chart(ctx, {",
                  "        type: \"bar\",",
                  "        data: {",
                  "            labels: [],",
                  "            datasets: [{",
                  "                label: \"Content Length (characters)\",",
                  "                data: [],",
                  "                backgroundColor: [",
                  "                    \"rgba(255, 99, 132, 0.7)\",",
                  "                    \"rgba(54, 162, 235, 0.7)\",",
                  "                    \"rgba(255, 206, 86, 0.7)\",",
                  "                    \"rgba(75, 192, 192, 0.7)\",",
                  "                    \"rgba(153, 102, 255, 0.7)\",",
                  "                    \"rgba(255, 159, 64, 0.7)\"",
                  "                ],",
                  "                borderColor: [",
                  "                    \"rgba(255, 99, 132, 1)\",",
                  "                    \"rgba(54, 162, 235, 1)\",",
                  "                    \"rgba(255, 206, 86, 1)\",",
                  "                    \"rgba(75, 192, 192, 1)\",",
                  "                    \"rgba(153, 102, 255, 1)\",",
                  "                    \"rgba(255, 159, 64, 1)\"",
                  "                ],",
                  "                borderWidth: 1",
                  "            }]",
                  "        },",
                  "        options: {",
                  "            legend: { display: true },",
                  "            title: {",
                  "                display: true,",
                  "                text: \"Posts by User - Content Length\"",
                  "            },",
                  "            scales: {",
                  "                xAxes: [{",
                  "                    display: true,",
                  "                    scaleLabel: {",
                  "                        display: true,",
                  "                        labelString: \"User\"",
                  "                    }",
                  "                }],",
                  "                yAxes: [{",
                  "                    display: true,",
                  "                    scaleLabel: {",
                  "                        display: true,",
                  "                        labelString: \"Content Length\"",
                  "                    },",
                  "                    ticks: {",
                  "                        beginAtZero: true",
                  "                    }",
                  "                }]",
                  "            }",
                  "        }",
                  "    });",
                  "",
                  "    pm.getData(function (err, value) {",
                  "        postsChart.data.labels = value.posts.map(function(post) { return post.user; });",
                  "        postsChart.data.datasets[0].data = value.posts.map(function(post) { return post.contentLength; });",
                  "        postsChart.update();",
                  "    });",
                  "</script>`;",
                  "",
                  "function constructVisualizerPayload() {",
                  "    return {",
                  "        posts: posts.map(function(post) {",
                  "            return {",
                  "                user: post.user,",
                  "                content: post.content,",
                  "                contentLength: post.content.length",
                  "            };",
                  "        })",
                  "    };",
                  "}",
                  "",
                  "pm.visualizer.set(template, constructVisualizerPayload());"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
